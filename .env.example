# 仅用于「服务端」运行时。禁止把这些变量复制为 VITE_* 前缀，
# VITE_* 会被 Vite 内联进浏览器产物，属于凭证泄露。
# M2 从 Node 服务端进程环境读取；以下仅为占位示例，留空即可运行模拟训练。

QODER_ACCESS_TOKEN=
QODER_API_BASE_URL=https://api.qoder.com.cn/api/v1/cloud
QODER_VISION_AGENT_ID=
QODER_VISION_ENVIRONMENT_ID=

# Node 运行载体；公网 HTTPS 反向代理需保留 Host 或配置此项。
SILVERGUIDE_PUBLIC_ORIGIN=
SILVERGUIDE_DAILY_AI_LIMIT=50
# 只有确实控制的反向代理 IP/CIDR 才填写（逗号分隔），留空不信任转发头。
SILVERGUIDE_TRUSTED_PROXY_CIDRS=
SILVERGUIDE_VISION_PER_IP_PER_MINUTE=4
SILVERGUIDE_VISION_GLOBAL_PER_MINUTE=60
SILVERGUIDE_VISION_MAX_CONCURRENT=4
SILVERGUIDE_VISION_MAX_CONCURRENT_PER_IP=1
SILVERGUIDE_DAILY_AI_PER_IP_LIMIT=20
SILVERGUIDE_VISION_BODY_TIMEOUT_MS=15000
HOST=127.0.0.1
PORT=8080
