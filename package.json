{
  "name": "silverguide",
  "version": "0.4.0-m3-rc.4",
  "private": true,
  "type": "module",
  "description": "SilverGuide 银龄引路人 — M3 发布候选版",
  "scripts": {
    "dev": "vite",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "generate:vision-fixtures": "pwsh -NoProfile -File scripts/generate-vision-fixtures.ps1",
    "verify:vision-fixtures": "node --test tests/vision/score.test.mjs tests/vision/session-response.test.mjs tests/vision/secret-scan.test.mjs && node scripts/evaluate-vision.mjs",
    "evaluate:vision": "node scripts/evaluate-vision.mjs",
    "build": "vue-tsc --noEmit && vite build && npm run build:server",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist-server/index.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "verify:secrets": "node scripts/check-no-secrets.mjs",
    "verify:ai": "node scripts/verify-cloud-agents.mjs",
    "verify:pwa": "node scripts/check-pwa.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run verify:secrets && npm run verify:pwa && npm run verify:vision-fixtures"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
